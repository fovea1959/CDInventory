<?xml version='1.0' encoding='utf-8'?>
<interface>
  <object class="tk.LabelFrame" id="table_container">
    <property name="background">#CCCCCC</property>
    <property name="borderwidth">0</property>
    <property name="padx">1</property>
    <property name="pady">1</property>
    <property name="text">Static Data Display</property>
    <layout>
      <property name="column">0</property>
      <property name="propagate">True</property>
      <property name="row">0</property>
    </layout>

    <!-- Row 0: Headers -->
    <child>
      <object class="tk.Label" id="header_product">
        <property name="background">#EAEAEA</property>
        <property name="font">Helvetica 10 bold</property>
        <property name="text">Product Item</property>
        <layout>
          <property name="column">0</property>
          <property name="pady">1</property>
          <property name="padx">1</property>
          <property name="row">0</property>
          <property name="sticky">nsew</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="tk.Label" id="header_price">
        <property name="background">#EAEAEA</property>
        <property name="font">Helvetica 10 bold</property>
        <property name="text">Retail Price</property>
        <layout>
          <property name="column">1</property>
          <property name="pady">1</property>
          <property name="padx">1</property>
          <property name="row">0</property>
          <property name="sticky">nsew</property>
        </layout>
      </object>
    </child>

    <!-- Row 1: Data -->
    <child>
      <object class="tk.Label" id="cell_1_1">
        <property name="background">#FFFFFF</property>
        <property name="text">Wireless Mouse</property>
        <layout>
          <property name="column">0</property>
          <property name="pady">1</property>
          <property name="padx">1</property>
          <property name="row">1</property>
          <property name="sticky">nsew</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="tk.Label" id="cell_1_2">
        <property name="background">#FFFFFF</property>
        <property name="text">$29.99</property>
        <layout>
          <property name="column">1</property>
          <property name="pady">1</property>
          <property name="padx">1</property>
          <property name="row">1</property>
          <property name="sticky">nsew</property>
        </layout>
      </object>
    </child>

    <!-- Row 2: Data -->
    <child>
      <object class="tk.Label" id="cell_2_1">
        <property name="background">#FFFFFF</property>
        <property name="text">Mechanical Keyboard</property>
        <layout>
          <property name="column">0</property>
          <property name="pady">1</property>
          <property name="padx">1</property>
          <property name="row">2</property>
          <property name="sticky">nsew</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="tk.Label" id="cell_2_2">
        <property name="background">#FFFFFF</property>
        <property name="text">$89.99</property>
        <layout>
          <property name="column">1</property>
          <property name="pady">1</property>
          <property name="padx">1</property>
          <property name="row">2</property>
          <property name="sticky">nsew</property>
        </layout>
      </object>
    </child>
  </object>
</interface>
